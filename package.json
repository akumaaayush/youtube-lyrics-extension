{
  "name": "youtube-lyrics-extension",
  "description": "Find lyrics in YouTube comments and pin them to the sidebar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.12.1",
    "pnpm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.12.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "for s in 16 32; do rsvg-convert -w $s -h $s assets/icon-small.svg -o public/icon/$s.png; done && for s in 48 96 128; do rsvg-convert -w $s -h $s assets/icon.svg -o public/icon/$s.png; done",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
